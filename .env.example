# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Port server Express
PORT=3000

# Mode penyimpanan: 'auto', 'postgres', atau 'json'
# Saat 'auto': Mencoba koneksi PostgreSQL. Jika gagal, otomatis fallback ke JSON Storage.
STORAGE_MODE="auto"

# Lokasi direktori penyimpanan JSON (relatif terhadap root server)
JSON_DATA_DIR="./data/storage"

# PostgreSQL Connection String (format standard PostgreSQL)
# Contoh: postgresql://siap_user:PasswordKuat123@localhost:5432/siap_kuliah_db?schema=public
DATABASE_URL="postgresql://siap_user:siap_secure_password@localhost:5432/siap_kuliah_db?schema=public"

# JWT Secret untuk token autentikasi API
JWT_SECRET="siap-kuliah-super-secret-key-production-change-this-in-production-2026"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Pengaturan Akademik & Absensi Default
DEFAULT_ATTENDANCE_MIN_PERCENTAGE="75"
DEFAULT_QR_INTERVAL_SECONDS="5"
DEFAULT_LATE_TOLERANCE_MINUTES="15"
SKS_MINUTES_PER_CREDIT="50"
TIMEZONE="Asia/Jakarta"
